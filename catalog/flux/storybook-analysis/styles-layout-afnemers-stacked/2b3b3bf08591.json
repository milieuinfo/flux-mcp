  "analysedFor": "2.2.0",
  "summary": "CSS-klassen die verticale witruimte zetten tussen de kinderen van een element, bv. de kolommen van een vl-grid: vl-stacked-small (1.5rem), vl-stacked-medium (3rem) en vl-stacked-large (6rem, op schermen tot 1023px 3rem). Zet de klasse op de parent: elk kind behalve het eerste krijgt die ruimte als margin-top, in een vl-grid bovenop de row-gap van de grid.",
  "keywords": [
    "stacked",
    "vl-stacked-small",
    "vl-stacked-medium",
    "vl-stacked-large",
    "stack",
    "stapelen",
    "margin-top",
    "witruimte",
    "whitespace",
    "vertical spacing",
    "spacing tussen elementen",
    "grid",
    "vl-grid"
  ],
  "examples": {
    "styles-layout-afnemers-stacked--stacked-large": {
      "html": "<style>\n    /* Demo-stijl van de story: maakt de lege kolommen zichtbaar als lijnen. */\n    .vl-grid .vl-column {\n        background-color: mediumspringgreen;\n        border: lightseagreen 2px solid;\n    }\n</style>\n<!-- vl-stacked-large geeft elk kind behalve het eerste een margin-top van 6rem, op schermen tot 1023px 3rem. -->\n<div class=\"vl-grid vl-stacked-large\">\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n</div>"
    },
    "styles-layout-afnemers-stacked--stacked-medium": {
      "html": "<style>\n    /* Demo-stijl van de story: maakt de lege kolommen zichtbaar als lijnen. */\n    .vl-grid .vl-column {\n        background-color: mediumspringgreen;\n        border: lightseagreen 2px solid;\n    }\n</style>\n<!-- vl-stacked-medium geeft elk kind behalve het eerste een margin-top van 3rem. -->\n<div class=\"vl-grid vl-stacked-medium\">\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n</div>"
    },
    "styles-layout-afnemers-stacked--stacked-small": {
      "html": "<style>\n    /* Demo-stijl van de story: maakt de lege kolommen zichtbaar als lijnen. */\n    .vl-grid .vl-column {\n        background-color: mediumspringgreen;\n        border: lightseagreen 2px solid;\n    }\n</style>\n<!-- vl-stacked-small geeft elk kind behalve het eerste een margin-top van 1.5rem; de row-gap van de vl-grid (1vmax) blijft. -->\n<div class=\"vl-grid vl-stacked-small\">\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n    <div class=\"vl-column vl-column--8 vl-column--start-3\"></div>\n</div>"
    }
