    "map-side-sheet-side-sheet-menu-item--map-side-sheet-menu-item-default": {
      "html": "<!-- vl-map-side-sheet-menu staat in een vl-map-side-sheet, met daarin het vl-map-side-sheet-menu-item. Dat toont\n     bovenaan een grijze balk met de link 'Terug' (title) naar href (standaard '#'), en daaronder zijn inhoud. De link is\n     een gewone link: de component stuurt zelf geen event. -->\n<vl-map lambert2008>\n    <vl-map-baselayer-grb-gray></vl-map-baselayer-grb-gray>\n    <vl-map-side-sheet>\n        <vl-map-side-sheet-menu>\n            <vl-map-side-sheet-menu-item>\n                <div>Plaats hier je zijpaneel content.</div>\n            </vl-map-side-sheet-menu-item>\n        </vl-map-side-sheet-menu>\n    </vl-map-side-sheet>\n</vl-map>"
    }
  },
