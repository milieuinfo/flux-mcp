    {
      "type": "mismatch",
      "element": "vl-http-error-message",
      "name": "error-code",
      "text": "Onder Varianten noemt de pagina vl-http-400-message en de andere specifieke http error messages deprecated. In 2.4.0 bestaan ze niet meer: de code en de web-types kennen enkel vl-http-error-message, en ticket UIG-3185 ('componenten geschrapt') in 2.0.0 verwijderde vl-http-400-message tot vl-http-506-message. Gebruik <vl-http-error-message error-code=\"...\">.",
      "source": "libs/components/src/block/http-error-message/stories/vl-http-error-message.stories-doc.mdx"
    },
    {
      "type": "mismatch",
      "element": "vl-http-error-message",
      "name": "title",
      "text": "De web-types beschrijven title als 'Past de title van de error message aan.', maar title is ook het globale HTML-attribuut. De component leest het attribuut (getAttribute('title')), zet de tekst in de h2 en laat het attribuut op het element staan, zodat de browser de titel ook als native tooltip toont wanneer je over de hele foutboodschap beweegt. De pagina en de web-types vermelden dat niet.",
      "source": "libs/components/src/block/http-error-message/vl-http-error-message.component.ts"
    }
