      "html": "<vl-http-error-message\n    title=\"Niets gevonden hiervoor.\"\n    image=\"https://cdn.milieuinfo.be/http-error-message-assets/LATEST/img/unexpected-error.svg\"\n    image-alt=\"Niets gevonden\"\n>\n    <p slot=\"text\">Sorry, er liep iets onverwachts mis.</p>\n    <div slot=\"actions\">\n        <vl-button cta-link=\"#\">Opnieuw opstarten</vl-button>\n    </div>\n</vl-http-error-message>",
      "js": "import { registerWebComponents } from '@domg-wc/common';\nimport { VlButtonComponent } from '@domg-wc/components/atom';\nimport { VlHttpErrorMessage } from '@domg-wc/components/block';\n\n// vl-http-error-message registreert zelf vl-link en vl-typography, maar niet de vl-button in het slot actions.\nregisterWebComponents([VlHttpErrorMessage, VlButtonComponent]);"
