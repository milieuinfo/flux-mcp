0px auto;\">\n            closable\n            <vl-pill closable type=\"warning\">pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            checkable\n            <vl-pill checkable type=\"warning\">pill</vl-pill>\n            <vl-pill checkable type=\"warning\" checked>pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            clickable\n            <vl-pill clickable type=\"warning\">pill</vl-pill>\n        </div>\n    </div>\n    <div>\n        <vl-title type=\"h2\">error</vl-title>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            default\n            <vl-pill type=\"error\">pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            closable\n            <vl-pill closable type=\"error\">pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            checkable\n            <vl-pill checkable type=\"error\">pill</vl-pill>\n            <vl-pill checkable type=\"error\" checked>pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            clickable\n            <vl-pill clickable type=\"error\">pill</vl-pill>\n        </div>\n    </div>\n    <div>\n        <vl-title type=\"h2\">disabled</vl-title>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            default\n            <vl-pill disabled>pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            closable\n            <vl-pill closable disabled>pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            checkable\n            <vl-pill checkable disabled>pill</vl-pill>\n            <vl-pill checkable disabled checked>pill</vl-pill>\n        </div>\n        <div style=\"display: grid; grid-template-columns: 100px 80px auto;\">\n            clickable\n            <vl-pill clickable disabled>pill</vl-pill>\n        </div>\n    </div>\n</div>"
