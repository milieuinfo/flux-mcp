  "analysedFor": "2.15.0",
  "summary": "Documentatie van vl-pill, een kleine pil om een status, een toegepaste filter of een badge te tonen. Een pill is closable (event close), checkable (event check, met detail.checked) of clickable (event click), krijgt met type de kleur success, warning of error en kan disabled zijn; eigen kleuren zet je met de CSS-variabelen --vl-pill--*. De pagina wijst erop dat kleur nooit het enige middel mag zijn om informatie over te brengen.",
  "keywords": [
    "pill",
    "vl-pill",
    "badge",
    "tag",
    "chip",
    "filter chip",
    "status",
    "statuslabel",
    "toegepaste filter",
    "filter",
    "closable",
    "checkable",
    "clickable",
    "aangepaste kleuren",
    "custom colors"
  ],
  "examples": {
    "components-block-pill--pill-default": {
      "html": "<vl-pill>Optie 1</vl-pill>",
      "js": "import { registerWebComponents } from '@domg-wc/common';\nimport { VlPillComponent } from '@domg-wc/components/block';\n\nregisterWebComponents([VlPillComponent]);\n\nconst pill = document.querySelector('vl-pill');\n// close volgt op een klik op het kruisje van een pill met closable. Het event bubbelt niet, en de pill verwijdert\n// zichzelf niet.\npill.addEventListener('close', (event) => {\n    console.log('close', event);\n});\n// check volgt op het aan- of uitvinken van een pill met checkable; event.detail.checked geeft de nieuwe toestand.\npill.addEventListener('check', (event) => {\n    console.log(event.detail.checked);\n});\n// click volgt op een klik op een pill met clickable.\npill.addEventListener('click', (event) => {\n    console.log('click', event);\n});"
    },
    "components-block-pill--pill-all-variants": {
